#!/bin/zsh
# Start the LBP6030w Printer Application on this Mac: an AirPrint / IPP Everywhere printer that Macs and iPhones on
# the same network find by themselves. Stop it with Ctrl-C.
#
# usage: printer-app/lbp6030-printer-app PRINTER_IP ["Printer name"]        (or set LBP6030_HOST)
# env:   LBP6030_PORT (default 8631)  LBP6030_DRY_RUN_DIR (write jobs there instead of printing)
DIR="${0:A:h}"
PRINTER="${1:-$LBP6030_HOST}"
[ -n "$PRINTER" ] || { echo "usage: $0 PRINTER_IP [\"Printer name\"]  (or set LBP6030_HOST)"; exit 1; }
NAME="${2:-LBP6030w}"

if ! python3 -c "import numpy, PIL" 2>/dev/null; then
    MSG="Python with numpy and Pillow not found. Run printer-app/install.sh again (or: python3 -m pip install numpy pillow)."
    echo "$MSG"
    osascript -e "display notification \"$MSG\" with title \"LBP6030 Printer App\"" 2>/dev/null
    exit 0      # a clean exit: launchd does not restart the job until this is fixed
fi
args=(serve "$PRINTER" --name "$NAME" --port "${LBP6030_PORT:-8631}")
[ -n "$LBP6030_DRY_RUN_DIR" ] && args+=(--dry-run "${LBP6030_DRY_RUN_DIR:a}")   # :a = absolute (we cd below)
cd "${DIR:h}" && exec python3 -m lbp6030 "${args[@]}"
